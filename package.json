{
  "name": "irys",
  "private": true,
  "version": "0.1.2",
  "description": "IRYS - your companion for healthier eyes. A 30-30-30 rule reminder that lives in your tray.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "docs:dev": "astro dev --root docs-site",
    "docs:build": "astro build --root docs-site",
    "docs:preview": "astro preview --root docs-site",
    "typecheck": "vue-tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "verify": "docker compose -f docker/compose.yml run --rm -T verify",
    "build:windows": "docker compose -f docker/compose.yml run --rm -T build-windows",
    "build:windows:release": "docker compose -f docker/compose.yml run --rm -T build-windows-release",
    "build:linux": "tauri build --bundles deb,appimage",
    "shell": "docker compose -f docker/compose.yml run --rm shell",
    "icon": "node scripts/make-icon.mjs && tauri icon icon-source.png"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.0",
    "@biomejs/biome": "2.5.13",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "astro": "7.3.2",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.12.2",
    "typescript": "~5.9.0",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  }
}
